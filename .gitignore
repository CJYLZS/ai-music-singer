# ---- 上游项目（各自是独立 git 仓库，不纳入本仓库）----
# 依赖冲突所以各带 .venv，总计 ~30GB；按 AGENTS.md 的说明单独 clone + 装环境
/GPT-SoVITS/
/SoulX-Singer/
/seed-vc/
/tools/pcnsf/
/tools/yingmusic/
/tools/voxcpm2/
/tools/hifiglot/
/tools/vevo2/
/echomimic3/
# a25rig 是 CJYLZS/Anime2.5DRig 分支 offline-render，单独提交到它自己的 remote。
# 不做 submodule：没有 .gitmodules 的裸 gitlink 对 clone 的人毫无用处，
# 而加 submodule 会把 driver/node_modules 与 nsslib 的获取方式也绑进来。
# 获取方式见 AGENTS.md「Anime2.5DRig 离线渲染」一节。
/a25rig/

# ---- 模型权重 ----
/tools/pcnsf_hifigan/
*.ckpt
*.pt
*.pth
*.onnx
*.safetensors

# ---- 数据与产物 ----
# data/voices = 语音素材, data/songs = 歌曲+分离stem+SVC输出, logs = 训练特征
/data/
/logs/
/girlish_v2Pro.zip
*.zip

# ---- 批量跑歌的临时脚本与日志、试听目录（一次性，不入库）----
/batch_run*.sh
/batch_run*.log
/check_batch_progress.sh
/listen_*/
# 单次实验的驱动脚本：歌名/参考/输出名全部硬编码，换歌要整个重写，
# 复现所需的信息在 docs/ 的报告里。对应的评测脚本 singing/eval_*.py 是通用的（带
# --song/--lengths），入库；驱动脚本不入库。
/test_*.sh

# listen_lipsync/ 撞上了上面的 /listen_*/ 规则，但它不是试听目录 —— 口型流水线的
# 脚本住在这里（README.md 的 ③ ④ 两步）。目录里另有 ~95MB 的 demo 视频和调试图，
# 所以只白名单脚本本身，不放行整个目录。
!/listen_lipsync/
/listen_lipsync/*
!/listen_lipsync/*.py

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ---- 自然度评测工具（tools/singmos：脚本入库，venv/权重缓存/临时文件不入库）----
/tools/singmos/.venv/
/tools/singmos/.torch-cache/
/tools/singmos/.s3prl-cache/
/tools/singmos/.uv-cache/
/tools/singmos/.uv-state/
/tools/singmos/.tmp/
/tools/singmos/.mplconfig/
# NISQA 官方仓库克隆（权重内置在仓库里）。重新获取：
#   git clone --depth 1 https://github.com/gabrielmittag/NISQA.git tools/nisqa
/tools/nisqa/

# ---- 编辑器/系统 ----
.DS_Store
.idea/
.vscode/

# source-norm 实验（源音色归一化预处理）
/.tmp/
/tools/source_norm/.venv/

# ---- 鼻音调研素材与缓存（非代码，doc/PDF/草稿/临时 session）----
/.nasref/
/.nasresearch/
/.npm-cache/
/natmos_report.json

# ---- 工具权重缓存（封装脚本与上游 repo 仍跟踪，见 a25rig 同款策略）----
# emotion2vec：本工作区只放权重缓存（.ms-cache），代码走 GPT-SoVITS venv 的 funasr
/tools/emotion2vec/
# indextts：保留 env.sh / prepare_ckpt.py / run_indextts.py 与 repo/（独立 git 上游），
# 忽略权重与各类缓存/venv。
/tools/indextts/checkpoints/
/tools/indextts/.ms-cache/
/tools/indextts/.torch-home/
/tools/indextts/.venv/
/tools/indextts/.uv-cache/
/tools/indextts/.uv-python/
/tools/indextts/.numba-cache/
/tools/indextts/.triton-cache/
/tools/indextts/.xdg-cache/
/tools/indextts/.xdg-config/
/tools/indextts/.hf-home/
/tools/indextts/.mpl/
/tools/indextts/.clone*.log
!/tools/indextts/env.sh
!/tools/indextts/prepare_ckpt.py
!/tools/indextts/run_indextts.py
!/tools/indextts/repo/
