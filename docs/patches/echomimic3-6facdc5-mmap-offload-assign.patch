+#!/usr/bin/env bash
+# EchoMimicV3-flash-pro 推理封装。
+#
+# 用法:
+#   ./run.sh smoke                      # 512x512 / 25帧，快速验证能否出片
+#   ./run.sh demo                       # 768x768 / 81帧，官方推荐参数
+#   ./run.sh <图片> <音频> [prompt]      # 自定义素材
+#
+# 环境变量可覆盖任意参数，例如:
+#   SIZE="768 512" LEN=49 STEPS=12 ./run.sh demo
+#   MEM=sequential_cpu_offload ./run.sh smoke
+#
+# 显存不足时按此顺序调整（都直接影响显存峰值）:
+#   1) SIZE="768 512"     降分辨率
+#   2) LEN=49             减帧数，必须是 8n+1
+#   3) SIZE="512 512"
+set -euo pipefail
+cd "$(dirname "$0")"
+
+PY=.venv/bin/python
+BASE=flash/Wan2.1-Fun-V1.1-1.3B-InP
+DIT=flash/transformer/diffusion_pytorch_model.safetensors
+W2V=flash/chinese-wav2vec2-base
+
+# ---- 可调参数（环境变量可覆盖）----
+STEPS=${STEPS:-8}                       # flash-pro 标称 8 步；说话头 5 步够，半身 15~25
+SIZE=${SIZE:-768 768}                   # 上限 768x768
+LEN=${LEN:-81}                          # 帧数，必须 8n+1；>138 需 Long Video CFG
+FPS=${FPS:-25}
+CFG=${CFG:-3.5}                         # 文本 CFG，官方建议 3~6
+ACFG=${ACFG:-3.0}                       # 音频 CFG，官方建议 1.8~3；调高口型更准
+SEED=${SEED:-43}
+MEM=${MEM:-model_cpu_offload}           # 整模型级卸载。sequential_cpu_offload 在本仓库缺辅助函数，不可用
+SAMPLER=${SAMPLER:-Flow_Unipc}
+TEACACHE=${TEACACHE:-1}                 # 1=开启，明显加速
+
+# ---- 预设 ----
+case "${1:-demo}" in
+  smoke)
+    IMG=datasets/echomimicv3_demos/imgs/01.jpg
+    AUD=datasets/echomimicv3_demos/audios/01.WAV
+    PROMPT="A person is speaking."
+    OUT=outputs/smoke01
+    SIZE=${SIZE_OVERRIDE:-512 512}; LEN=${LEN_OVERRIDE:-25}
+    ;;
+  demo)
+    IMG=datasets/echomimicv3_demos/imgs/01.jpg
+    AUD=datasets/echomimicv3_demos/audios/01.WAV
+    PROMPT=$(cat datasets/echomimicv3_demos/prompts/01.txt)
+    OUT=outputs/demo01
+    ;;
+  *)
+    IMG=$1
+    AUD=${2:?用法: ./run.sh <图片> <音频> [prompt]}
+    PROMPT=${3:-"A person is speaking."}
+    OUT=${OUT:-outputs/$(basename "${IMG%.*}")_$(basename "${AUD%.*}")}
+    ;;
+esac
+
+[[ -f "$IMG" ]] || { echo "找不到图片: $IMG" >&2; exit 1; }
+[[ -f "$AUD" ]] || { echo "找不到音频: $AUD" >&2; exit 1; }
+
+# 音频必须是立体声 WAV：mono 或 mp3 会导致完全没有口型（Wan/LTX 同源的已知问题）
+if command -v ffprobe >/dev/null; then
+  ch=$(ffprobe -v error -select_streams a:0 -show_entries stream=channels -of csv=p=0 "$AUD" 2>/dev/null || echo "")
+  if [[ "$ch" == "1" ]]; then
+    echo "警告: $AUD 是单声道，很可能完全没有口型。转立体声:" >&2
+    echo "  ffmpeg -i '$AUD' -ac 2 -ar 44100 '${AUD%.*}_stereo.wav'" >&2
+  fi
+  # infer_flash.py 只是把源音频原样复制进 MP4，不做任何增益，所以源素材偏轻
+  # 会直接表现为「视频没声音」。常规语音 RMS 约 -16~-20dB。
+  rms=$(ffmpeg -hide_banner -nostats -i "$AUD" -af astats=metadata=1 -f null - 2>&1 \
+        | grep -m1 "RMS level dB" | grep -oE -- "-?[0-9.]+" || echo "")
+  if [[ -n "$rms" ]] && awk "BEGIN{exit !($rms < -24)}" 2>/dev/null; then
+    echo "提示: $AUD 电平偏低 (RMS ${rms}dB)，成片可能听着像没声音。可先标准化:" >&2
+    echo "  ffmpeg -i '$AUD' -af loudnorm=I=-18:TP=-2 -ac 2 -ar 44100 '${AUD%.*}_norm.wav'" >&2
+  fi
+fi
+
+TEA_ARGS=()
+[[ "$TEACACHE" == "1" ]] && TEA_ARGS=(--enable_teacache --teacache_threshold 0.1 --num_skip_start_steps 5)
+
+echo "图片:   $IMG"
+echo "音频:   $AUD  ($(ffprobe -v error -show_entries format=duration -of csv=p=0 "$AUD" 2>/dev/null || echo '?')s)"
+echo "输出:   $OUT"
+echo "参数:   ${SIZE// /x} / ${LEN}帧@${FPS}fps / ${STEPS}步 / cfg=$CFG acfg=$ACFG / seed=$SEED"
+echo "显存:   $MEM   (teacache=$TEACACHE)"
+echo
+
+# shellcheck disable=SC2086
+exec $PY infer_flash.py \
+  --image_path "$IMG" \
+  --audio_path "$AUD" \
+  --prompt "$PROMPT" \
+  --config_path config/config.yaml \
+  --model_name "$BASE" \
+  --transformer_path "$DIT" \
+  --wav2vec_model_dir "$W2V" \
+  --save_path "$OUT" \
+  --num_inference_steps "$STEPS" \
+  --sampler_name "$SAMPLER" \
+  --video_length "$LEN" --fps "$FPS" \
+  --sample_size $SIZE \
+  --guidance_scale "$CFG" --audio_guidance_scale "$ACFG" \
+  --seed "$SEED" --weight_dtype bfloat16 \
+  "${TEA_ARGS[@]}" \
+  --GPU_memory_mode "$MEM"
