+    # OOM-killed (exit 137) right after the VAE loads, before inference starts.
+    # "sequential_cpu_offload" keeps weights on CPU and streams them per-submodule
+    # (lowest VRAM and lowest RAM, slowest); "model_cpu_offload" moves whole models
+    # in and out per forward pass; anything else keeps upstream's eager behaviour.
+    if GPU_memory_mode == "sequential_cpu_offload":
+        print("[mem] sequential_cpu_offload: streaming weights per submodule")
+        pipeline.enable_sequential_cpu_offload(device=device)
+    elif GPU_memory_mode == "model_cpu_offload":
+        print("[mem] model_cpu_offload: offloading whole models between forwards")
