+#!/usr/bin/env python3
+"""
+Download EchoMimicV3-flash-pro weights with VERIFIED byte-offset resume.
+
+Why not huggingface_hub's snapshot_download:
+  hf_hub writes to <sha256>.<etag-derived-suffix>.incomplete. The suffix is
+  renegotiated on every process start, so a restart creates a NEW temp file and
+  re-downloads from byte 0 — silently discarding whatever was already fetched.
+  This cost ~10 GB of redundant transfer on models_t5_umt5-xxl-enc-bf16.pth
+  (11.36 GB) before it was caught.
+
+What this does instead:
+  Downloads to a fixed "<target>.part" filename and resumes with an HTTP Range
+  request from the current byte offset. Verified against the HF CDN: it answers
+  Range requests with HTTP 206 and byte-identical content. Each file is checked
+  against the repo's LFS sha256 before being promoted to its final name, so a
+  truncated or corrupt transfer can never be mistaken for a good one.
+
+Idempotent: files already present and hash-verified are skipped.
+
+Target layout (matches run_flash.sh defaults):
+  flash/
+  ├── Wan2.1-Fun-V1.1-1.3B-InP/   base model + VAE + T5 + CLIP + tokenizers
+  ├── chinese-wav2vec2-base/       audio encoder (Flash path)
+  └── transformer/                 flash-pro DiT weights
+"""
+import hashlib
+import os
+import subprocess
+import sys
+
+from huggingface_hub import HfApi
+
+ROOT = os.path.dirname(os.path.abspath(__file__))
+FLASH = os.path.join(ROOT, "flash")
+
+# (repo_id, repo_filename, local_path_relative_to_FLASH)
+TARGETS = [
+    # --- base model: Wan2.1-Fun-V1.1-1.3B-InP ---
+    ("alibaba-pai/Wan2.1-Fun-V1.1-1.3B-InP", "diffusion_pytorch_model.safetensors",
+     "Wan2.1-Fun-V1.1-1.3B-InP/diffusion_pytorch_model.safetensors"),
+    ("alibaba-pai/Wan2.1-Fun-V1.1-1.3B-InP", "Wan2.1_VAE.pth",
+     "Wan2.1-Fun-V1.1-1.3B-InP/Wan2.1_VAE.pth"),
+    ("alibaba-pai/Wan2.1-Fun-V1.1-1.3B-InP", "models_t5_umt5-xxl-enc-bf16.pth",
+     "Wan2.1-Fun-V1.1-1.3B-InP/models_t5_umt5-xxl-enc-bf16.pth"),
+    # Required: infer_flash.py:270 loads this unconditionally and passes it to the
+    # pipeline at :294. Not optional despite flash-pro needing no face mask.
+    ("alibaba-pai/Wan2.1-Fun-V1.1-1.3B-InP",
+     "models_clip_open-clip-xlm-roberta-large-vit-huge-14.pth",
+     "Wan2.1-Fun-V1.1-1.3B-InP/models_clip_open-clip-xlm-roberta-large-vit-huge-14.pth"),
+    ("alibaba-pai/Wan2.1-Fun-V1.1-1.3B-InP", "config.json",
+     "Wan2.1-Fun-V1.1-1.3B-InP/config.json"),
+    ("alibaba-pai/Wan2.1-Fun-V1.1-1.3B-InP", "configuration.json",
+     "Wan2.1-Fun-V1.1-1.3B-InP/configuration.json"),
+    # tokenizers (config.yaml: tokenizer_subpath = google/umt5-xxl)
+    ("alibaba-pai/Wan2.1-Fun-V1.1-1.3B-InP", "google/umt5-xxl/tokenizer.json",
+     "Wan2.1-Fun-V1.1-1.3B-InP/google/umt5-xxl/tokenizer.json"),
+    ("alibaba-pai/Wan2.1-Fun-V1.1-1.3B-InP", "google/umt5-xxl/spiece.model",
+     "Wan2.1-Fun-V1.1-1.3B-InP/google/umt5-xxl/spiece.model"),
+    ("alibaba-pai/Wan2.1-Fun-V1.1-1.3B-InP", "google/umt5-xxl/tokenizer_config.json",
+     "Wan2.1-Fun-V1.1-1.3B-InP/google/umt5-xxl/tokenizer_config.json"),
+    ("alibaba-pai/Wan2.1-Fun-V1.1-1.3B-InP", "google/umt5-xxl/special_tokens_map.json",
+     "Wan2.1-Fun-V1.1-1.3B-InP/google/umt5-xxl/special_tokens_map.json"),
+
+    # --- audio encoder (Flash path uses the Chinese wav2vec2) ---
+    # Deliberately NOT fetching chinese-wav2vec2-base-fairseq-ckpt.pt (~1.2 GB):
+    # infer_flash.py:210 uses Wav2Vec2Model.from_pretrained(), which reads
+    # pytorch_model.bin + config.json only.
+    ("TencentGameMate/chinese-wav2vec2-base", "pytorch_model.bin",
+     "chinese-wav2vec2-base/pytorch_model.bin"),
+    ("TencentGameMate/chinese-wav2vec2-base", "config.json",
+     "chinese-wav2vec2-base/config.json"),
+    ("TencentGameMate/chinese-wav2vec2-base", "preprocessor_config.json",
+     "chinese-wav2vec2-base/preprocessor_config.json"),
+
+    # --- EchoMimicV3-flash-pro transformer ---
+    ("BadToBest/EchoMimicV3", "echomimicv3-flash-pro/diffusion_pytorch_model.safetensors",
+     "transformer/diffusion_pytorch_model.safetensors"),
+    ("BadToBest/EchoMimicV3", "echomimicv3-flash-pro/config.json",
+     "transformer/config.json"),
+]
+
+
+def sha256_file(path, chunk=8 << 20):
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        while True:
+            b = f.read(chunk)
+            if not b:
+                break
+            h.update(b)
+    return h.hexdigest()
+
+
+def fetch_meta():
+    """Map (repo_id, filename) -> (size, sha256). sha256 is None for non-LFS files."""
+    api = HfApi()
+    meta = {}
+    for repo in sorted({t[0] for t in TARGETS}):
+        info = api.model_info(repo, files_metadata=True)
+        for s in info.siblings:
+            meta[(repo, s.rfilename)] = (
+                s.size,
+                s.lfs.sha256 if s.lfs else None,
+            )
+    return meta
+
+
+def download(repo_id, repo_file, dest):
+    url = f"https://huggingface.co/{repo_id}/resolve/main/{repo_file}"
+    part = dest + ".part"
+    os.makedirs(os.path.dirname(dest), exist_ok=True)
+    have = os.path.getsize(part) if os.path.exists(part) else 0
+    if have:
+        print(f"    resuming from {have / 1e9:.2f} GB")
+    # -C - : resume by byte offset against a FIXED filename (the whole point).
+    # --retry with resume keeps working because the offset is re-read from disk.
+    subprocess.run(
+        ["curl", "-fL", "-C", "-", "--retry", "5", "--retry-delay", "3",
+         "--progress-bar", "-o", part, url],
+        check=True,
+    )
+    return part
+
+
+def main():
+    meta = fetch_meta()
+    todo, skipped = [], 0
+
+    for repo_id, repo_file, rel in TARGETS:
+        dest = os.path.join(FLASH, rel)
+        size, want_hash = meta.get((repo_id, repo_file), (None, None))
+        if os.path.exists(dest) and size and os.path.getsize(dest) == size:
+            skipped += 1
+            continue
+        todo.append((repo_id, repo_file, rel, dest, size, want_hash))
+
+    total = sum(t[4] or 0 for t in todo)
+    print(f"already complete: {skipped} file(s)")
+    print(f"to download:      {len(todo)} file(s), {total / 1e9:.2f} GB\n")
+
+    for i, (repo_id, repo_file, rel, dest, size, want_hash) in enumerate(todo, 1):
+        gb = (size or 0) / 1e9
+        print(f"[{i}/{len(todo)}] {rel}  ({gb:.2f} GB)")
+        part = download(repo_id, repo_file, dest)
+
+        if size and os.path.getsize(part) != size:
+            sys.exit(f"  ! size mismatch: got {os.path.getsize(part)}, want {size}")
+        if want_hash:
+            got = sha256_file(part)
+            if got != want_hash:
+                sys.exit(f"  ! sha256 mismatch\n    got  {got}\n    want {want_hash}")
+            print("  sha256 ok")
+        os.replace(part, dest)
+        print("  done\n")
+
+    print("=== all weights present and verified ===")
+    print(f"model root: {FLASH}/")
+
+
+if __name__ == "__main__":
+    main()
